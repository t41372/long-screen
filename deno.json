{
  "name": "long-screen",
  "version": "2.0.0",
  "exports": "./main.ts",
  "tasks": {
    "build:core": "bash scripts/build-core.sh",
    "build": "deno run --allow-read --allow-write --allow-run --allow-env --allow-net=jsr.io,api.jsr.io scripts/build.ts",
    "build:prod": "deno run --allow-read --allow-write --allow-run --allow-env --allow-net=jsr.io,api.jsr.io scripts/build.ts --production",
    "build:portable": {
      "command": "deno run --allow-read --allow-write --allow-run=git scripts/build-portable.ts",
      "dependencies": ["build:prod"]
    },
    "start": "deno run --allow-read --allow-net --allow-run --allow-env --allow-write main.ts",
    "dev": "deno task build && deno task start",
    "check": "deno check src/**/*.ts main.ts scripts/**/*.ts tests/**/*.ts",
    "test": {
      "command": "deno test --allow-read --allow-write --allow-env --parallel tests/unit",
      "dependencies": ["build:core", "test:rust"]
    },
    "test:rust": "cd rust && cargo test --lib",
    "test:browser": "deno test --allow-all tests/browser",
    "coverage": {
      "command": "deno run --allow-read --allow-write --allow-run --allow-env scripts/coverage.ts",
      "dependencies": ["build:core"]
    },
    "fixtures": "deno run --allow-read --allow-write --allow-run --allow-env scripts/make-fixtures.ts",
    "fmt": "deno fmt src main.ts scripts tests README.md docs && cd rust && cargo fmt",
    "lint": "deno lint src main.ts scripts tests && cd rust && cargo fmt --check && cargo clippy --target wasm32-unknown-unknown -- -D warnings && RUSTC_BOOTSTRAP=1 RUSTFLAGS='-C link-arg=--export=__heap_base -C target-feature=+atomics,+bulk-memory,+mutable-globals,+simd128 -C link-arg=--shared-memory -C link-arg=--import-memory -C link-arg=--initial-memory=33554432 -C link-arg=--max-memory=2147483648 -C link-arg=--export=__stack_pointer -C link-arg=--export=__wasm_init_tls -C link-arg=--export=__tls_size -C link-arg=--export=__tls_align -C link-arg=--export=__tls_base' cargo clippy --target wasm32-unknown-unknown -Zbuild-std=panic_abort,std --target-dir target/lint-threads -- -D warnings",
    "fingerprint": "deno run -A scripts/fingerprint-scenarios.ts"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": false
  },
  "fmt": {
    "lineWidth": 140,
    "singleQuote": true,
    "semiColons": true,
    "proseWrap": "preserve"
  },
  "lint": {
    "rules": {
      "exclude": [
        "require-await",
        "no-control-regex",
        "no-window",
        "no-window-prefix",
        "no-explicit-any"
      ]
    }
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/path": "jsr:@std/path@1",
    "@std/fs": "jsr:@std/fs@1",
    "@std/http": "jsr:@std/http@1",
    "playwright": "npm:playwright@1.58.2",
    "client-zip": "npm:client-zip@2.5.1",
    "fflate": "npm:fflate@0.8.3",
    "i18next": "npm:i18next@26.4.2",
    "i18next-browser-languagedetector": "npm:i18next-browser-languagedetector@8.2.1",
    "mediabunny": "npm:mediabunny@1.59.0"
  }
}
