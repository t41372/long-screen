# build output: `deno task build` regenerates it
dist/
dist.build*/
dist-portable/
# the npm package: `deno task build:package` regenerates it
dist-package/
dist-package.build/
# the browser suite's own dev build (tests/browser/support.ts) and its staging directory
dist-test/
dist-test.build/
rust/target/
# coverage and test artefacts
.coverage/
coverage/
test-results/
# baseline checkout for A/B benchmarks (benchmark-pipeline.ts --baseline-root)
.baseline/
# user recordings used for manual verification (large, private)
test_case/
node_modules/
.DS_Store
# Python package (rust/python): bytecode and pytest cache
__pycache__/
.pytest_cache/
